# Direct-download URL for efficientnetv2_weights_aug.pth
# Hugging Face example: https://huggingface.co/<username>/<repo>/resolve/main/efficientnetv2_weights_aug.pth
MODEL_URL=

# Comma-separated list of allowed frontend origins (no trailing slash)
# Example: https://malaria-detect.vercel.app,https://malaria-detect.netlify.app
FRONTEND_URL=

# Set automatically by Render/Railway — safe to leave unset locally (defaults to 5000)
PORT=5000
